textBox.Parent = screenGui

local duckRainExecuted = false -- Track if duckrain has been executed

-- Function to handle TextBox input
textBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local inputText = textBox.Text:lower() -- Convert input to lowercase for consistency

        -- Handle empty input
        if inputText == "" then
            textBox.Text = "no script entered"
            print("[INFO] No script entered in the TextBox!")
            return
        end

        -- Handle ":cmds" command
        if inputText == ":cmds" then
            -- Display available commands
            local textLabel = Instance.new("TextLabel")
            textLabel.Size = textBox.Size -- Same size as TextBox
            textLabel.Position = UDim2.new(0.1, 0, 0.1, 20) -- Slightly below the TextBox
            textLabel.BackgroundColor3 = textBox.BackgroundColor3 -- Same background color
            textLabel.BackgroundTransparency = textBox.BackgroundTransparency -- Same transparency
            textLabel.TextColor3 = textBox.TextColor3 -- Same text color
            textLabel.Font = textBox.Font -- Same font
            textLabel.TextScaled = textBox.TextScaled -- Same text scaling
            textLabel.Text = "cmds: :G00bysStigmaV2Spam, :SSC, :Console, :credits, :duckrain"
            textLabel.Parent = screenGui

            print("[INFO] Commands displayed successfully!")

            -- Remove label after 10 seconds
            task.delay(10, function()
                if textLabel.Parent then
                    textLabel:Destroy()
                end
            end)
        -- Handle ":duckrain" command
        elseif inputText == ":duckrain" then
            if not duckRainExecuted then
                duckRainExecuted = true
                print("[INFO] Duck rain executed successfully!")

                -- Duck rain logic
                local meshId = "rbxassetid://7102117818"
                local function spawnMesh()
                    local part = Instance.new("Part")
                    part.Size = Vector3.new(2, 2, 2)
                    part.Anchored = false
                    part.Position = Vector3.new(math.random(-50, 50), 100, math.random(-50, 50))
                    part.BrickColor = BrickColor.new("Bright yellow")
                    part.Parent = game.Workspace

                    local mesh = Instance.new("SpecialMesh", part)
                    mesh.MeshId = meshId
                    mesh.Scale = Vector3.new(2, 2, 2)

                    local velocity = Instance.new("BodyVelocity", part)
                    velocity.Velocity = Vector3.new(0, -20, 0)

                    game:GetService("Debris"):AddItem(part, 5)
                end

                while true do
                    spawnMesh()
                    wait(0.1)
                end
            else
                print("[ERROR] Duckrain has already been executed")
            end
        -- Handle ":G00bysStigmaV2Spam" command
        elseif inputText == ":g00bysstigmalv2spam" then
            print("[INFO] Executing G00bysStigmaV2Spam script!")

            -- Decals
            local function applyDecalsToParts()
                local decalId = "rbxassetid://7102117818"
                for _, part in pairs(game.Workspace:GetDescendants()) do
                    if part:IsA("BasePart") then
                        for _, face in pairs(Enum.NormalId:GetEnumItems()) do
                            local decal = Instance.new("Decal", part)
                            decal.Face = face
                            decal.Texture = decalId
                        end
                    end
                end
            end
            applyDecalsToParts()

            -- Skybox
            local function updateSkybox()
                local skyboxId = "rbxassetid://7102117818"
                local lighting = game:GetService("Lighting")
                local sky = lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky", lighting)
                sky.SkyboxBk = skyboxId
                sky.SkyboxDn = skyboxId
                sky.SkyboxFt = skyboxId
                sky.SkyboxLf = skyboxId
                sky.SkyboxRt = skyboxId
                sky.SkyboxUp = skyboxId
            end
            updateSkybox()

            -- Hint
            local hint = Instance.new("Hint", game.Workspace)
            hint.Text = "bravo skid, g00byd0lan exploit de natural disasters survival"
        -- Handle ":SSC" command
        elseif inputText == ":ssc" then
            print("[INFO] Executing SSC script!")

            -- Apply decals
            local decalId = "rbxassetid://158118263"
            for _, part in pairs(game.Workspace:GetDescendants()) do
                if part:IsA("BasePart") then
                    for _, face in pairs(Enum.NormalId:GetEnumItems()) do
                        local decal = Instance.new("Decal", part)
                        decal.Face = face
                        decal.Texture = decalId
                    end
                end
            end

            -- Update Skybox
            local function updateSkybox()
                local skyboxId = "rbxassetid://11664604903"
                local lighting = game:GetService("Lighting")
                local sky = lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky", lighting)
                sky.SkyboxBk = skyboxId
                sky.SkyboxDn = skyboxId
                sky.SkyboxFt = skyboxId
                sky.SkyboxLf = skyboxId
                sky.SkyboxRt = skyboxId
                sky.SkyboxUp = skyboxId
            end
            updateSkybox()

            -- Play audio
            local sound = Instance.new("Sound", game.Workspace)
            sound.SoundId = "rbxassetid://133180219581309"
            sound.Pitch = 0.15
            sound.Looped = true
            sound.Volume = 10
            sound:Play()
        -- Handle ":Console" command
        elseif inputText == ":console" then
            print("[INFO] Opening console!")
            game:GetService("StarterGui"):SetCore("DevConsoleVisible", true)
        -- Handle ":credits" command
        elseif inputText == ":credits" then
            local creditsLabel = Instance.new("TextLabel")
            creditsLabel.Size = textBox.Size
            creditsLabel.Position = UDim2.new(0.1, 0, 0.2, 30) -- Below cmds label
            creditsLabel.BackgroundColor3 = textBox.BackgroundColor3
            creditsLabel.BackgroundTransparency = textBox.BackgroundTransparency
            creditsLabel.TextColor3 = textBox.TextColor3
            creditsLabel.Font = textBox.Font
            creditsLabel.TextScaled = textBox.TextScaled
            creditsLabel.Text = "Credits to Copilot for the UI and a bit of scripts, Big thanks to tubers93 for most of the scripts and the client replicator, Credits to The Infamous Epic Face for the watermark"
            creditsLabel.Parent = screenGui
        else
            print("[INFO] Unknown command entered: " .. inputText)
        end

        -- Clear the TextBox
        textBox.Text = ""
    end
end)

